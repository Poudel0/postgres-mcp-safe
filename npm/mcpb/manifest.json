{
  "manifest_version": "0.4",
  "name": "postgres-mcp-safe",
  "display_name": "Postgres (read-only transactions)",
  "version": "0.0.0",
  "description": "Drop-in replacement for @modelcontextprotocol/server-postgres that is actually read-only.",
  "author": { "name": "Sandesh Poudel", "url": "https://github.com/Poudel0" },
  "repository": { "type": "git", "url": "https://github.com/Poudel0/postgres-mcp-safe" },
  "homepage": "https://github.com/Poudel0/postgres-mcp-safe",
  "license": "MIT",
  "keywords": ["postgres", "postgresql", "sql", "database", "read-only"],
  "server": {
    "type": "node",
    "entry_point": "server/postgres-mcp-safe.js",
    "mcp_config": {
      "command": "node",
      "args": ["${__dirname}/server/postgres-mcp-safe.js", "${user_config.database_url}"]
    }
  },
  "tools_generated": true,
  "compatibility": { "platforms": ["darwin", "linux", "win32"], "runtimes": { "node": ">=18" } },
  "user_config": {
    "database_url": {
      "type": "string",
      "title": "Postgres connection URL",
      "description": "For example postgresql://mcp_ro:password@localhost:5432/mydb. Use a read-only role: superusers are refused.",
      "required": true,
      "sensitive": true
    }
  }
}
